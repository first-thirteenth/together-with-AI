# Telegram Bot — required for the quiz form to send messages.
# These are SERVER-SIDE secrets (NO "VITE_" prefix) so they are never
# bundled into the public client JS. They are read by the serverless
# function api/lead.ts (and by the Vite dev middleware in development).
#
# On Vercel: add these in Project Settings -> Environment Variables.

# Create a bot via @BotFather and get the token
TELEGRAM_TOKEN=your_bot_token_here

# Telegram chat ID where quiz submissions will be sent
# Get it by messaging @userinfobot in Telegram
TELEGRAM_CHAT_ID=your_chat_id_here
